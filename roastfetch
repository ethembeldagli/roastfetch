def alias_files(shell: str) -> list[str]:
    """Where shells pick up aliases, system files first so the user's own win."""
    fish = shell == "fish"
    if fish:
        files = sorted(glob.glob(f"{HOST}/usr/share/fish/vendor_conf.d/*.fish"))
        files += sorted(glob.glob(f"{HOST}/etc/fish/conf.d/*.fish"))
        files += [f"{HOME}/.config/fish/config.fish"] + sorted(glob.glob(f"{HOME}/.config/fish/conf.d/*.fish"))
    else:
        files = sorted(glob.glob(f"{HOST}/etc/profile.d/*.sh")) + [f"{HOST}/etc/bashrc", f"{HOST}/etc/bash.bashrc"]
        files += [f"{HOME}/.bashrc", f"{HOME}/.bash_aliases"] + sorted(glob.glob(f"{HOME}/.bashrc.d/*"))
        if shell == "zsh":
            files += [f"{HOST}/etc/zshrc", f"{HOST}/etc/zsh/zshrc", f"{HOME}/.zshrc"]
    return files


def find_alias(tool: str, shell: str) -> str | None:
    found = None
    for path in alias_files(shell):
        for m in re.finditer(rf"^\s*alias\s+{tool}(?:=|\s+)(['\"])(.+?)\1\s*$", read(path), re.M):
            found = m.group(2)  # later definitions win, like in the shell
    return found


def expand_alias(text: str, fish: bool, via_host: bool) -> list[str]:
    """Turn an alias into argv: run its $(...) / (...) substitutions, expand $VARS and ~."""
    def substitute(m: re.Match) -> str:
        argv = ["sh", "-c", m.group(1)]
        return run(["distrobox-host-exec", *argv] if via_host else argv, timeout=3).strip()
    text = re.sub(r"\$\(([^()]*)\)", substitute, text)
    if fish:
        text = re.sub(r"(?<![\w$])\(([^()]*)\)", substitute, text)
    return [os.path.expanduser(os.path.expandvars(a)) for a in shlex.split(text)]


def fetch_command(shell: str) -> list[str] | None:
    """Exactly what typing `neofetch` (or else `fastfetch`) would run in your shell."""
    for tool in ("neofetch", "fastfetch"):
        alias = find_alias(tool, shell)
        if alias:
            exe = alias.split()[0]
            local = os.path.exists(exe) if exe.startswith("/") else bool(shutil.which(exe))
            on_host = IN_BOX and os.path.exists(f"/run/host{exe if exe.startswith('/') else '/usr/bin/' + exe}")
            if local or on_host:
                argv = expand_alias(alias, shell == "fish", via_host=not local)
                return argv if local else ["distrobox-host-exec", *argv]
        if shutil.which(tool):
            return [tool]
        if IN_BOX and shutil.which("distrobox-host-exec") and os.path.exists(f"/run/host/usr/bin/{tool}"):
            return ["distrobox-host-exec", tool]
    return None


def run_fetch(argv: list[str]) -> bool:
    """Let the fetch tool draw straight into the terminal, so it looks exactly as usual."""
    try:
        sys.stdout.flush()
        return subprocess.run(argv, timeout=20).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


