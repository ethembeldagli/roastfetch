def a(word: str) -> str:
    """'a' or 'an' + word."""
    return ("an " if word[:1].lower() in "aeiou" else "a ") + word


def pick(rng: random.Random, options: list[str]) -> str:
    return rng.choice(options)


def roasts(f: dict, rng: random.Random) -> list[tuple[int, str]]:
    """Candidate roasts as (heat, text). Heat decides what makes the cut."""
    out: list[tuple[int, str]] = []
    add = lambda heat, text: out.append((heat, text))  # noqa: E731

    did = f["distro_id"]
    options = DISTRO_ROASTS.get(did) or next(
        (DISTRO_ROASTS[x] for x in f["distro_like"].split() if x in DISTRO_ROASTS), None)
    add(5, pick(rng, options) if options else f"{f['distro']}: so niche even DistroWatch blinked.")
    if f["atomic"] and did not in ("bazzite", "aurora", "bluefin"):
        add(2, "An immutable OS. Finally, something you can't break. Probably.")
    if f["box"]:
        add(4, pick(rng, [f"Running this inside {f['box']} on {f['distro']}. Matryoshka computing.",
                          f"A{a(f['box'])[1:]} box on {f['distro']}. You put Linux in your Linux.",
                          "Fetching from inside a container. Even your terminal needs a safe space."]))

    model = f["model"]
    handheld = next((h for h in HANDHELDS if re.search(h[0], model, re.I)), None)
    if handheld:
        add(5, handheld[1].format(model=model))
    elif any(k.lower() in model.lower() for k in GAMING_LAPTOPS):
        add(3, f"{model}: an RGB keyboard with a laptop attached.")
    elif "ThinkPad" in model:
        add(2, "A ThinkPad running Linux. The least surprising thing on this screen.")
    elif "MacBook" in model:
        add(4, "Linux on a MacBook. Somewhere in Cupertino, a disturbance.")
    elif "Framework" in model:
        add(3, "Framework laptop: repairable hardware, unrepairable dotfiles.")

    k = f["kernel"].lower()
    flavour = next((x.strip("-") for x in FLAVOURS if x in k), "")
    if flavour:
        add(3, f"A custom kernel ({flavour}). Gained 1 FPS, lost a weekend.")
    major = re.match(r"(\d+)\.(\d+)", f["kernel"])
    if major and int(major.group(1)) < 6:
        add(4, f"Kernel {major.group(0)}. Older than some of your memes.")

    days = f["uptime_s"] / 86400
    if days >= 30:
        add(4, pick(rng, [f"Up {int(days)} days. Kernel updates are knocking. Loudly.",
                          f"{int(days)} days of uptime. That's not stability, that's fear of rebooting."]))
    elif days >= 7:
        add(2, f"Up {int(days)} days. The reboot button misses you.")
    elif f["uptime_s"] < 600:
        add(3, f"Booted {int(f['uptime_s'] // 60)} minutes ago. What did you break?")

    pk = f["packages"]
    native = sum(v for k2, v in pk.items() if k2.split()[0] in ("rpm", "dpkg", "pacman") and "box" not in k2)
    if pk.get("flatpak", 0) >= 40:
        add(4, pick(rng, [f"{pk['flatpak']} Flatpaks, each with its own runtime. Your SSD is crying.",
                          f"{pk['flatpak']} Flatpaks. Flathub should send you a loyalty card.",
                          f"{pk['flatpak']} Flatpaks and at least six copies of GTK. Efficient."]))
    elif pk.get("flatpak", 0) >= 15:
        add(2, f"{pk['flatpak']} Flatpaks. Sandboxes all the way down.")
    if native >= 3000:
        add(3, f"{native:,} packages. You install things the way other people breathe.")
    if pk.get("snap", 0) >= 5:
        add(3, f"{pk['snap']} snaps. Slow startup is a lifestyle choice.")
    if pk.get("brew"):
        add(2, f"Homebrew on Linux with {pk['brew']} formulae. A stranger in a strange land.")

    shell = f["shell"]
    if shell == "zsh" and f["ohmyzsh"]:
        add(3, "oh-my-zsh: 400 ms of startup time for a git branch name.")
    elif shell in SHELL_ROASTS:
        add(2, pick(rng, SHELL_ROASTS[shell]))
    if f["starship"]:
        add(2, "A Starship prompt: two lines tall, showing a Node version you don't use.")

    de = f["desktop"].lower()
    if de in DESKTOP_ROASTS:
        add(3, pick(rng, DESKTOP_ROASTS[de]))
    elif not de and not f["box"]:
        add(3, "No desktop at all. Just you and the TTY. Hardcore.")
    if f["session"] == "x11" and de not in ("i3", "dwm", "xfce"):
        add(2, "Still on X11. Wayland's been ready for years, apparently.")

    if f["terminal"] in TERMINAL_ROASTS:
        add(2, pick(rng, TERMINAL_ROASTS[f["terminal"]]))

    gpu = " ".join(f["gpus"]).lower()
    if "nvidia" in gpu and ("intel" in gpu or "amd" in gpu):
        add(4, "Hybrid graphics: one GPU works, the other one judges you.")
    elif "nvidia" in gpu:
        add(4, pick(rng, ["NVIDIA on Linux. You enjoy suffering, don't you?",
                          "NVIDIA: installing the driver was your whole personality for a week."]))
    elif "amd" in gpu or "radeon" in gpu:
        add(1, "AMD graphics: Mesa does all the work, you take all the credit.")
    elif "intel" in gpu:
        add(2, "Intel graphics. Gaming? In this economy?")

    cpu = f["cpu"].lower()
    if f["threads"] >= 24:
        add(2, f"{f['threads']} threads to run a terminal. Overkill is your love language.")
    elif f["threads"] <= 4:
        add(3, f"{f['threads']} threads. Your compiler sends its regards.")
    elif "intel" in cpu:
        add(1, "An Intel CPU: a space heater with benefits.")

    total_gib = f["mem_total_kib"] / 1048576
    used_pct = 100 * f["mem_used_kib"] / max(1, f["mem_total_kib"])
    if total_gib and total_gib <= 8.5:
        add(3, f"{total_gib:.0f} GiB of RAM and a web browser. Choose one.")
    elif total_gib >= 60:
        add(2, f"{total_gib:.0f} GiB of RAM. Planning to open every tab ever?")
    if used_pct >= 80:
        add(3, f"{used_pct:.0f}% of your RAM is in use. Browser tabs breed when you're not looking.")

    disk_pct = 100 * f["disk_used"] / max(1, f["disk_total"])
    if disk_pct >= 90:
        add(4, pick(rng, [f"Disk {disk_pct:.0f}% full. Collecting ISOs like Pokémon?",
                          f"Disk {disk_pct:.0f}% full. One more game update and it's over."]))
    elif disk_pct >= 75:
        add(3, pick(rng, [f"Disk {disk_pct:.0f}% full. ~/Downloads is a lifestyle, apparently.",
                          f"Disk {disk_pct:.0f}% full. Shader caches are people too, I guess."]))

    if f["battery_health"] is not None and f["battery_health"] < 80:
        add(3, f"Battery at {f['battery_health']}% of its original capacity. It's tired. So are we.")

    ed = f["editor"]
    if ed in EDITOR_ROASTS:
        add(2, EDITOR_ROASTS[ed][0])
    elif not ed:
        add(2, "No $EDITOR set. Git will open vi one day and you will panic.")

    h = f["history"]
    if h:
        if h["typo"]:
            typo, n = h["typo"]
            times = f"{n} time{'s' if n != 1 else ''}"
            add(4, pick(rng, [f"You typed `{typo}` {times}. Autocorrect can't save you here.",
                              f"`{typo}`, {times}. Your fingers have a mind of their own."]))
        if h["sudo"] >= 20 and h["sudo"] / max(1, h["total"]) > 0.08:
            add(4, pick(rng, [f"{h['sudo']} sudos in your history. Root is not a personality.",
                              f"{h['sudo']} sudos. You and root should get a room."]))
        if h["clears"] >= 25:
            add(3, f"You cleared the screen {h['clears']} times. Hiding something?")
        if h["top"] in TOP_COMMANDS:
            add(2, TOP_COMMANDS[h["top"]])
        if h["total"] < 60:
            add(3, f"Only {h['total']} commands in your history. Terminal tourist?")
        elif h["total"] > 20000:
            add(3, f"{h['total']:,} commands in your history. Do you ever go outside?")

    s = f["steam"]
    if s.get("top") and s.get("top_hours", 0) >= 100:
        add(4, pick(rng, [f"{s['top_hours']}h in {s['top']}. Touching grass is free, you know.",
                          f"{s['top_hours']}h in {s['top']}. That's {s['top_hours'] // 24} full days. Worth it?",
                          f"{s['top']} has {s['top_hours']}h of your life. It's not giving them back."]))
    elif s.get("hours", 0) >= 300:
        add(3, f"{s['hours']} hours on Steam. That's {s['hours'] // 24} days. Worth it?")

    age = f["home_age_days"]
    if age is not None and age < 45:
        add(3, pick(rng, [f"Your home folder is {age} days old. Distro-hopper detected.",
                          f"Fresh install, {age} days ago. How long until the next one?"]))

    if f["hour"] < 5:
        add(4, pick(rng, [f"It's {f['hour'] or 12} AM and you're running roastfetch. Go to sleep.",
                          f"{f['hour'] or 12} AM. Your sleep schedule has a segfault."]))

    add(1, pick(rng, ["You ran a program whose only job is to insult you. Interesting choice.",
                      "You installed a tool to roast you. Therapy is cheaper.",
                      "Screenshotting this for Reddit, aren't you?"]))
    return out


def choose(cands: list[tuple[int, str]], n: int, rng: random.Random) -> list[tuple[int, str]]:
    ranked = sorted(cands, key=lambda c: c[0] + rng.random() * 1.5, reverse=True)
    return ranked[:n]


def verdict(chosen: list[tuple[int, str]]) -> tuple[str, int]:
    heat = sum(h for h, _ in chosen)
    score = max(1, min(10, round(10 * heat / (5 * max(1, len(chosen))))))
    level = ("Rare" if score <= 3 else "Medium" if score <= 6 else "Well done" if score <= 8 else "Charcoal")
    return level, score


