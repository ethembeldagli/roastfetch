def borrowed_logo(name: str | None, colour: bool, small: bool = False) -> list[str]:
    """The exact logo your own fetch tool draws, so roastfetch shows the icon you're used to.
    Tries fastfetch, then neofetch; inside a distrobox, the host's copy. small=True asks
    fastfetch for the compact version it uses in narrow terminals."""
    ff = ["fastfetch", "--structure", "break", "--logo-print-remaining", "true", "--pipe", "false"]
    if small:
        ff += ["--logo-type", "small"]
    nf = ["neofetch", "-L"]
    if name:
        ff += ["--logo", name]
        nf += ["--ascii_distro", name]
    attempts = [cmd for cmd in (ff, nf) if shutil.which(cmd[0])]
    if not attempts and IN_BOX and shutil.which("distrobox-host-exec"):
        attempts = [["distrobox-host-exec", *ff], ["distrobox-host-exec", *nf]]
    for cmd in attempts:
        out = run(cmd, timeout=3)
        # keep colours, drop cursor movement and other non-colour escapes
        lines = [ANSI_ANY.sub(lambda m: m.group(0) if m.group(0).endswith("m") else "", line).rstrip()
                 for line in out.splitlines()]
        while lines and not ANSI_SGR.sub("", lines[0]).strip():
            lines.pop(0)
        while lines and not ANSI_SGR.sub("", lines[-1]).strip():
            lines.pop()
        if len(lines) >= 3:
            return [line + "\x1b[0m" if colour else ANSI_SGR.sub("", line) for line in lines]
    return []


def logo_for(distro_id: str) -> str:
    did = LOGO_ALIASES.get(distro_id, distro_id)
    return did if did in LOGOS else "tux"


def logo_rows(name: str, paint: "Paint", flames_only: bool = False) -> list[str]:
    """Pixel-art logo plus campfire (or just the campfire), as terminal rows of half blocks."""
    rows = []
    for palette, pixels in ((FLAMES,) if flames_only else (LOGOS[name], FLAMES)):
        if not paint.on:
            # Without colour, white details (the f, the B...) become holes so they stay visible.
            pixels = [r.replace("w", ".") for r in pixels]
        for y in range(0, len(pixels), 2):
            top_row = pixels[y]
            bot_row = pixels[y + 1] if y + 1 < len(pixels) else "." * len(top_row)
            line = ""
            for t, b in zip(top_row, bot_row):
                ct, cb = palette.get(t), palette.get(b)
                if ct and cb and ct == cb:
                    line += paint("█", ct)
                elif ct and cb:
                    line += paint("▀", ct, bg=cb)
                elif ct:
                    line += paint("▀", ct)
                elif cb:
                    line += paint("▄", cb)
                else:
                    line += " "
            rows.append(line)
    return rows


ACCENTS = {
    "arch": "#1793d1", "endeavouros": "#7f3fbf", "manjaro": "#35bf5c", "cachyos": "#00b4d8", "garuda": "#ff4d6d",
    "ubuntu": "#e95420", "pop": "#48b9c7", "linuxmint": "#87cf3e", "debian": "#d70a53", "fedora": "#3c6eb4",
    "bazzite": "#8c5cf0", "aurora": "#5aa9ff", "bluefin": "#4c8cff", "nixos": "#7ebae4", "gentoo": "#9a8fe8",
    "void": "#478061", "alpine": "#4c9bd6", "opensuse-tumbleweed": "#73ba25", "opensuse-leap": "#73ba25",
    "kali": "#367bf0", "zorin": "#15a6f0", "elementary": "#64baff", "steamos": "#1a9fff",
}
FLAME = ["#ff3b30", "#ff8a00", "#ffd60a"]


class Paint:
    def __init__(self, enabled: bool):
        self.on = enabled
        self.true = os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit")

    def _code(self, layer: str, colour: str) -> str:
        r, g, b = (int(colour[i:i + 2], 16) for i in (1, 3, 5))
        if self.true:
            return f"{layer};2;{r};{g};{b}"
        q = lambda v: 0 if v < 48 else 1 if v < 115 else (v - 35) // 40  # noqa: E731
        return f"{layer};5;{16 + 36 * q(r) + 6 * q(g) + q(b)}"

    def __call__(self, text: str, colour: str | None = None, bold: bool = False, dim: bool = False,
                 bg: str | None = None) -> str:
        if not self.on:
            return text
        codes = []
        if bold:
            codes.append("1")
        if dim:
            codes.append("2")
        if colour:
            codes.append(self._code("38", colour))
        if bg:
            codes.append(self._code("48", bg))
        return f"\x1b[{';'.join(codes)}m{text}\x1b[0m" if codes else text


def fmt_uptime(sec: float) -> str:
    d, rem = divmod(int(sec), 86400)
    h, m = rem // 3600, rem % 3600 // 60
    return ", ".join(p for p in (f"{d}d" if d else "", f"{h}h" if h else "", f"{m}m") if p)


def info_lines(f: dict) -> list[tuple[str, str]]:
    rows = [("OS", f["distro"] + (" (atomic)" if f["atomic"] else ""))]
    if f["box"]:
        rows.append(("Box", f["box"]))
    if f["model"]:
        rows.append(("Host", f["model"]))
    rows.append(("Kernel", f["kernel"]))
    rows.append(("Uptime", fmt_uptime(f["uptime_s"])))
    if f["packages"]:
        rows.append(("Packages", ", ".join(f"{v:,} ({k})" for k, v in f["packages"].items())))
    if f["shell"]:
        rows.append(("Shell", f["shell"]))
    if f["desktop"]:
        rows.append(("Desktop", f["desktop"] + (f" ({f['session'].capitalize()})" if f["session"] else "")))
    if f["terminal"]:
        rows.append(("Terminal", f["terminal"]))
    if f["cpu"]:
        rows.append(("CPU", f"{f['cpu']} ({f['threads']})"))
    for i, g in enumerate(f["gpus"][:2]):
        rows.append(("GPU", g))
    if f["mem_total_kib"]:
        rows.append(("Memory", f"{gib(f['mem_used_kib'])} / {gib(f['mem_total_kib'])}"))
    if f["disk_total"]:
        rows.append(("Disk", f"{f['disk_used'] / 2**30:.0f} / {f['disk_total'] / 2**30:.0f} GiB "
                             f"({100 * f['disk_used'] / f['disk_total']:.0f}%)"))
    if f["battery_health"] is not None:
        rows.append(("Battery", f"{f['battery_health']}% health"))
    if f["steam"].get("hours"):
        rows.append(("Steam", f"{f['steam']['hours']:,}h across {f['steam']['games']} games"))
    return rows


def render(f: dict, chosen: list[tuple[int, str]], paint: Paint, show_logo: bool, roast: bool,
           logo_name: str | None = None, pixel: bool = False) -> str:
    accent = ACCENTS.get(f["distro_id"]) or next(
        (ACCENTS[x] for x in f["distro_like"].split() if x in ACCENTS), "#ffb000")
    width = shutil.get_terminal_size((100, 24)).columns
    title = f"{f['user']}@{f['hostname']}"
    rows = info_lines(f)
    key_w = max(len(k) for k, _ in rows)

    def right_column(max_value: int | None = None) -> list[str]:
        out = [paint(title, accent, bold=True), paint("─" * len(title), dim=True)]
        for key, value in rows:
            if max_value is not None and len(value) > max_value:
                value = value[:max(1, max_value - 1)] + "…"
            out.append(f"{paint(key.ljust(key_w), accent, bold=True)}  {value}")
        return out

    right_w = max(len(title), *(key_w + 2 + len(v) for _, v in rows))
    logo: list[str] = []
    if show_logo:
        if not pixel:
            # The full logo if it fits next to the specs, else fastfetch's small one.
            room = width - right_w - 3
            for small in ((False, True) if room >= 30 else (True,)):
                candidate = borrowed_logo(logo_name, paint.on, small)
                if candidate and (small or max(visible_len(c) for c in candidate) <= room):
                    logo = candidate
                    break
            if logo:
                w = max(visible_len(line) for line in logo)
                pad = " " * max(0, (w - 20) // 2)
                logo += [""] + [pad + row for row in logo_rows("tux", paint, flames_only=True)]
        if not logo:
            logo = logo_rows(logo_for(logo_name or f["distro_id"]), paint)
    logo_w = max((visible_len(line) for line in logo), default=0)
    room = width - logo_w - 3
    if logo and room < key_w + 2 + 12:
        logo, room = [], width  # tiny terminal: specs and roast matter more than the art
    right = right_column(room - key_w - 2 if right_w > room else None)

    lines = []
    for i in range(max(len(right), len(logo))):
        left = ""
        if logo:
            cell = logo[i] if i < len(logo) else ""
            left = cell + " " * (logo_w - visible_len(cell)) + "   "
        lines.append(left + (right[i] if i < len(right) else ""))

    out = "\n".join(lines) + "\n"
    if roast and chosen:
        out += render_roast(chosen, paint)
    return out


def render_roast(chosen: list[tuple[int, str]], paint: Paint) -> str:
    lines = ["", paint("  roasted:", FLAME[0], bold=True)]
    for _, text in chosen:
        lines.append(f"  {paint('›', FLAME[1], bold=True)} {text}")
    level, score = verdict(chosen)
    bar = paint("▰" * score, FLAME[1]) + paint("▱" * (10 - score), dim=True)
    lines += ["", f"  {paint('Doneness:', FLAME[2], bold=True)} {level} {bar} {score}/10"]
    return "\n".join(lines) + "\n"


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="roastfetch", description="A system fetch that roasts you.")
    p.add_argument("-n", "--roasts", type=int, default=5, metavar="N", help="how many roasts (default 5)")
    p.add_argument("--seed", type=int, help="pick the same roasts every time")
    p.add_argument("--no-roast", action="store_true", help="just the fetch, no feelings hurt")
    p.add_argument("--builtin", action="store_true", help="roastfetch's own fetch display instead of your neofetch/fastfetch")
    p.add_argument("--only-roast", action="store_true", help="skip the fetch, just the roast")
    p.add_argument("--no-logo", action="store_true", help="hide the logo (built-in display)")
    p.add_argument("--logo", metavar="DISTRO", help="show another distro's logo (any name fastfetch knows)")
    p.add_argument("--pixel-logo", action="store_true", help="use roastfetch's own pixel-art logo")
    p.add_argument("--no-color", action="store_true", help="plain text")
    p.add_argument("--color", action="store_true", help="colors even when not printing to a terminal")
    p.add_argument("--demo", action="store_true", help="roast a made-up example system instead of yours")
    p.add_argument("--json", action="store_true", help="print the collected facts as JSON")
    p.add_argument("--version", action="version", version=f"roastfetch {__version__}")
    args = p.parse_args(argv)

    facts = dict(DEMO) if args.demo else collect()
    if args.json:
        print(json.dumps(facts, indent=2, default=str))
        return 0
    rng = random.Random(args.seed)
    chosen = choose(roasts(facts, rng), max(0, args.roasts), rng)
    colour = args.color or (sys.stdout.isatty() and not args.no_color and not os.environ.get("NO_COLOR"))
    paint = Paint(colour)
    roast = not args.no_roast
    if args.only_roast:
        sys.stdout.write(render_roast(chosen, paint) if chosen else "")
        return 0
    # Normally: your own neofetch/fastfetch, exactly as you know it, then the roast.
    builtin = args.builtin or args.demo or args.logo or args.pixel_logo or args.no_logo
    command = None if builtin else fetch_command(facts["shell"])
    shell = facts["shell"]
    shell_path = shutil.which(shell) if shell in SHELLS and shell not in ("sh", "dash") else None
    if command and shell_path and roast and chosen and sys.stdout.isatty():
        # Become your shell running "fetch; roast", so the fetch tool's parent really is your
        # shell and it reports it exactly as usual (it shows its parent process as "Shell").
        me = os.path.realpath(sys.argv[0]) if os.path.exists(sys.argv[0]) else os.path.realpath(__file__)
        seed = args.seed if args.seed is not None else random.randrange(1 << 30)
        roast_cmd = [sys.executable, me, "--only-roast", "--seed", str(seed), "-n", str(args.roasts),
                     "--color" if colour else "--no-color"]
        sys.stdout.flush()
        os.execv(shell_path, [shell, "-c", f"{shlex.join(command)}; {shlex.join(roast_cmd)}"])
    if command and run_fetch(command):
        if roast and chosen:
            sys.stdout.write(render_roast(chosen, paint))
        return 0
    logo = args.logo or (facts["distro_id"] if args.demo else None)
    sys.stdout.write(render(facts, chosen, paint, not args.no_logo, roast, logo, args.pixel_logo))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except BrokenPipeError:
        raise SystemExit(0)
