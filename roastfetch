def detect_terminal(parents: list[str]) -> str:
    for name in parents:
        if name in TERMINALS:
            return TERMINALS[name]
    env = os.environ
    program = env.get("TERM_PROGRAM", "")
    if program:
        return {"vscode": "VS Code", "claude-desktop": "Claude", "iTerm.app": "iTerm2",
                "WezTerm": "WezTerm", "ghostty": "Ghostty", "tmux": "tmux"}.get(program, program)
    term = env.get("TERM", "")
    for key, name in (("kitty", "kitty"), ("ghostty", "Ghostty"), ("alacritty", "Alacritty"), ("foot", "foot"),
                      ("wezterm", "WezTerm")):
        if key in term:
            return name
    if env.get("KONSOLE_VERSION"):
        return "Konsole"
    if env.get("PTYXIS_VERSION"):
        return "Ptyxis"
    if env.get("VTE_VERSION"):
        return "a VTE terminal"
    return ""


def detect_desktop() -> str:
    env = os.environ
    for var, name in (("HYPRLAND_INSTANCE_SIGNATURE", "Hyprland"), ("NIRI_SOCKET", "niri"),
                      ("SWAYSOCK", "Sway"), ("I3SOCK", "i3")):
        if env.get(var):
            return name
    de = (env.get("XDG_CURRENT_DESKTOP") or env.get("DESKTOP_SESSION") or "").split(":")[-1]
    return {"KDE": "KDE Plasma", "X-Cinnamon": "Cinnamon", "XFCE": "Xfce", "COSMIC": "COSMIC"}.get(de, de)


def packages() -> dict:
    counts: dict[str, int] = {}
    for root, label in ((HOST, ""), ("", " in box")) if HOST else (("", ""),):
        status = read(f"{root}/var/lib/dpkg/status")
        if status:
            counts["dpkg" + label] = status.count("Status: install ok installed")
        for db in (f"{root}/usr/lib/sysimage/rpm/rpmdb.sqlite", f"{root}/var/lib/rpm/rpmdb.sqlite"):
            if os.path.isfile(db):
                try:
                    con = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True)
                    counts["rpm" + label] = con.execute("SELECT count(*) FROM Packages").fetchone()[0]
                    con.close()
                    break
                except sqlite3.Error:
                    pass
        n = count_dirs(f"{root}/var/lib/pacman/local")
        if n:
            counts["pacman" + label] = n
    apps = set()
    for base in (f"{HOST}/var/lib/flatpak/app", f"{HOME}/.local/share/flatpak/app"):
        try:
            apps.update(e.name for e in os.scandir(base) if e.is_dir())
        except OSError:
            pass
    if apps:
        counts["flatpak"] = len(apps)
    snaps = [d for d in glob.glob(f"{HOST}/snap/*") if os.path.basename(d) not in ("bin", "README")]
    if snaps:
        counts["snap"] = len(snaps)
    n = count_dirs("/home/linuxbrew/.linuxbrew/Cellar") or count_dirs(f"{HOST}/var/home/linuxbrew/.linuxbrew/Cellar")
    if n:
        counts["brew"] = n
    return counts


def pci_device_name(ids: str, vid: str, did: str) -> str:
    """Look a device up in pci.ids, e.g. '1002','150e' -> 'Radeon 880M / 890M'."""
    in_vendor = False
    for line in ids.splitlines():
        if not line or line.startswith("#"):
            continue
        if not line.startswith("\t"):
            if in_vendor:
                break
            in_vendor = line.startswith(f"{vid}  ")
        elif in_vendor and line.startswith(f"\t{did}  "):
            return re.sub(r".*\[(.*)\].*", r"\1", line[len(did) + 3:])
    return ""


def gpus() -> list[str]:
    names = []
    out = run(["lspci", "-mm"])
    for line in out.splitlines():
        if re.search(r'"(VGA compatible controller|3D controller|Display controller)"', line):
            parts = re.findall(r'"([^"]*)"', line)
            if len(parts) >= 3:
                vendor = parts[1]
                for long, short in (("Advanced Micro Devices", "AMD"), ("NVIDIA", "NVIDIA"), ("Intel", "Intel")):
                    if long in vendor:
                        vendor = short
                model = re.sub(r".*\[(.*)\].*", r"\1", parts[2])
                names.append(f"{vendor} {model}".strip())
    if not names:  # no lspci (e.g. in a container): look the IDs up in pci.ids ourselves
        ids = read("/usr/share/hwdata/pci.ids") or read(f"{HOST}/usr/share/hwdata/pci.ids") \
            or read("/usr/share/misc/pci.ids")
        for dev in glob.glob("/sys/bus/pci/devices/*"):
            if not read(f"{dev}/class").startswith("0x03"):
                continue
            vid, did = read(f"{dev}/vendor").strip()[2:], read(f"{dev}/device").strip()[2:]
            vendor = {"10de": "NVIDIA", "1002": "AMD", "8086": "Intel"}.get(vid, "")
            model = pci_device_name(ids, vid, did)
            name = f"{vendor} {model}".strip()
            if name and name not in names:
                names.append(name)
    return names


def battery() -> int | None:
    for bat in glob.glob("/sys/class/power_supply/BAT*"):
        for full, design in (("energy_full", "energy_full_design"), ("charge_full", "charge_full_design")):
            try:
                f, d = int(read(f"{bat}/{full}") or 0), int(read(f"{bat}/{design}") or 0)
            except ValueError:
                continue
            if f and d:
                return round(100 * f / d)
    return None


SKIP_WORDS = {"do", "done", "then", "fi", "else", "esac", "in", "for", "while", "if", "case", "function"}
TYPOS = {"sl": "ls", "gti": "git", "got": "git", "claer": "clear", "celar": "clear", "cler": "clear",
         "pyhton": "python", "pytohn": "python", "sudp": "sudo", "suod": "sudo", "grpe": "grep", "gerp": "grep",
         "mkae": "make", "ehco": "echo", "exti": "exit", "cd..": "cd ..", "nnao": "nano", "vmi": "vim"}


def history() -> dict:
    lines: list[str] = []
    timed = False
    bash = read(os.environ.get("HISTFILE") or f"{HOME}/.bash_history")
    for line in bash.splitlines():
        if re.fullmatch(r"#\d{9,11}", line):
            timed = True
        elif line.strip():
            lines.append(line)
    for path in (f"{HOME}/.zsh_history", f"{HOME}/.zhistory", f"{HOME}/.histfile"):
        for line in read(path).splitlines():
            m = re.match(r": \d+:\d+;(.*)", line)
            if m:
                timed = True
            lines.append(m.group(1) if m else line)
    for line in read(f"{HOME}/.local/share/fish/fish_history").splitlines():
        if line.startswith("- cmd: "):
            lines.append(line[7:])
            timed = True
    if not lines:
        return {}
    counts: dict[str, int] = {}
    sudo = clears = 0
    typos: dict[str, int] = {}
    for line in lines:
        for part in re.split(r"\|\||&&|[|;]", line):
            words = part.split()
            while words and (re.match(r"^\w+=", words[0]) or words[0] in ("sudo", "doas", "run0", "time", "env", "nohup")):
                if words[0] in ("sudo", "doas", "run0"):
                    sudo += 1
                words = words[1:]
                while words and words[0].startswith("-"):
                    words = words[1:]
            if not words:
                continue
            cmd = os.path.basename(words[0])
            if cmd in TYPOS and not shutil.which(cmd):
                typos[cmd] = typos.get(cmd, 0) + 1
                continue
            if cmd in SKIP_WORDS or not re.fullmatch(r"[a-z][a-z0-9._+-]{0,30}", cmd):
                continue
            counts[cmd] = counts.get(cmd, 0) + 1
            if cmd in ("clear", "cls", "reset"):
                clears += 1
    top = sorted(counts.items(), key=lambda kv: -kv[1])
    return {
        "total": len(lines), "timed": timed, "sudo": sudo, "clears": clears,
        "top": top[0][0] if top else "", "top_n": top[0][1] if top else 0,
        "typo": max(typos.items(), key=lambda kv: kv[1]) if typos else None,
    }


_VDF = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])')


def parse_vdf(text: str) -> dict:
    root: dict = {}
    stack, key = [root], None
    for m in _VDF.finditer(text):
        s, brace = m.group(1), m.group(2)
        if brace == "{":
            child: dict = {}
            if key is not None:
                stack[-1][key.lower()] = child
            stack.append(child)
            key = None
        elif brace == "}":
            if len(stack) > 1:
                stack.pop()
            key = None
        elif key is None:
            key = s
        else:
            stack[-1][key.lower()] = s
            key = None
    return root


def steam() -> dict:
    roots = {os.path.realpath(os.path.expanduser(p)) for p in (
        "~/.local/share/Steam", "~/.steam/steam", "~/.var/app/com.valvesoftware.Steam/.local/share/Steam",
        "~/snap/steam/common/.local/share/Steam") if os.path.isdir(os.path.expanduser(p))}
    minutes: dict[str, int] = {}
    names: dict[str, str] = {}
    for root in roots:
        for acf in glob.glob(f"{root}/steamapps/appmanifest_*.acf"):
            st = parse_vdf(read(acf)).get("appstate", {})
            if st.get("appid") and st.get("name"):
                names[st["appid"]] = st["name"]
        for cfg in glob.glob(f"{root}/userdata/*/config/localconfig.vdf"):
            apps = parse_vdf(read(cfg))
            for k in ("userlocalconfigstore", "software", "valve", "steam", "apps"):
                apps = apps.get(k, {}) if isinstance(apps, dict) else {}
            for appid, info in apps.items():
                playtime = str(info.get("playtime", "")) if isinstance(info, dict) else ""
                if playtime.isdigit():
                    minutes[appid] = max(minutes.get(appid, 0), int(playtime))
    played = {a: m for a, m in minutes.items() if m > 0 and not re.match(r"Proton|Steam Linux Runtime", names.get(a, ""))}
    if not played:
        return {}
    top = max((a for a in played if a in names), key=lambda a: played[a], default=None)
    return {"hours": sum(played.values()) // 60, "games": len(played),
            "top": names.get(top, ""), "top_hours": played[top] // 60 if top else 0}


def home_age_days() -> int | None:
    out = run(["stat", "-c", "%W", HOME]).strip()
    if out.isdigit() and int(out) > 0:
        return int((time.time() - int(out)) // 86400)
    return None


def safe(fn, default):
    """A fetch must never crash: a broken source just drops its line."""
    try:
        return fn()
    except Exception:
        return default


def collect() -> dict:
    rel = os_release(HOST) if HOST else os_release()
    box = os_release() if HOST else {}
    parents = parent_names()
    shell = next((p for p in parents if p in SHELLS), os.path.basename(os.environ.get("SHELL", "")))
    mem = dict(re.findall(r"^(\w+):\s+(\d+)", read("/proc/meminfo"), re.M))
    total, avail = int(mem.get("MemTotal", 0)), int(mem.get("MemAvailable", 0))
    disk = os.statvfs(HOME)
    disk_total = disk.f_blocks * disk.f_frsize
    disk_used = disk_total - disk.f_bavail * disk.f_frsize
    cpu = re.search(r"^model name\s*:\s*(.+)$", read("/proc/cpuinfo"), re.M)
    product = read("/sys/class/dmi/id/product_name").strip()
    if "O.E.M" in product or product.lower() in ("system product name", "default string"):
        product = ""
    vendor = read("/sys/class/dmi/id/sys_vendor").strip()
    vendor = "" if "O.E.M" in vendor else vendor.replace("ASUSTeK COMPUTER INC.", "ASUS")
    return {
        "user": os.environ.get("USER") or os.path.basename(HOME),
        "hostname": platform.node(),
        "distro": rel.get("PRETTY_NAME") or rel.get("NAME") or "Linux",
        "distro_id": rel.get("ID", "linux"),
        "distro_like": rel.get("ID_LIKE", ""),
        "variant": rel.get("VARIANT_ID", ""),
        "atomic": os.path.exists(f"{HOST}/run/ostree-booted") or os.path.exists("/run/ostree-booted"),
        "box": (box.get("PRETTY_NAME", "a container") if IN_BOX else ""),
        "model": re.sub(r"\s+[A-Z0-9]{4,}(_[A-Z0-9]+)+$", "", f"{vendor} {product}".strip()) if product else "",
        "kernel": platform.release(),
        "uptime_s": float((read("/proc/uptime") or "0").split()[0]),
        "packages": safe(packages, {}),
        "shell": shell,
        "ohmyzsh": os.path.isdir(f"{HOME}/.oh-my-zsh"),
        "starship": bool(os.environ.get("STARSHIP_SHELL") or os.environ.get("STARSHIP_SESSION_KEY")),
        "desktop": detect_desktop(),
        "session": os.environ.get("XDG_SESSION_TYPE", ""),
        "terminal": detect_terminal(parents),
        "cpu": re.sub(r"\s+", " ", re.sub(r"\((R|TM)\)|CPU|Processor|\d+-Core", "", cpu.group(1))).strip() if cpu else "",
        "threads": os.cpu_count() or 1,
        "gpus": safe(gpus, []),
        "mem_total_kib": total, "mem_used_kib": total - avail,
        "disk_total": disk_total, "disk_used": disk_used,
        "battery_health": safe(battery, None),
        "editor": os.path.basename((os.environ.get("VISUAL") or os.environ.get("EDITOR") or "").split(" ")[0]),
        "history": safe(history, {}),
        "steam": safe(steam, {}),
        "home_age_days": safe(home_age_days, None),
        "hour": dt.datetime.now().hour,
    }


